{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Digital Nasab application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile photo URL." },
        "role": { "type": "string", "enum": ["admin", "viewer"], "description": "The user's role (admin or viewer)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the user was last updated." }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "A member of a family tree.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The member's unique ID." },
        "ownerId": { "type": "string", "description": "The ID of the user who owns this record." },
        "fullName": { "type": "string", "description": "The member's full name." },
        "gender": { "type": "string", "enum": ["male", "female"], "description": "The member's gender." },
        "isAlive": { "type": "boolean", "description": "Whether the member is currently alive." },
        "birthDate": { "type": "string", "description": "The member's birth date." },
        "deathDate": { "type": "string", "description": "The member's death date." },
        "address": { "type": "string", "description": "The member's address." },
        "parentId": { "type": "string", "description": "The ID of the member's primary parent (usually father)." },
        "motherId": { "type": "string", "description": "The ID of the member's mother." },
        "spouseId": { "type": "string", "description": "The ID of the member's spouse." },
        "photoUrl": { "type": "string", "format": "uri", "description": "The member's photo URL." },
        "phone": { "type": "string", "description": "The member's phone number." },
        "bio": { "type": "string", "description": "A short biography of the member." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the record was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the record was last updated." }
      },
      "required": ["id", "ownerId", "fullName", "gender", "isAlive", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Stores family members for all users."
    }
  }
}
